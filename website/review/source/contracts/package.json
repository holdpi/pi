{
  "name": "holdpi-bnb-review",
  "version": "0.3.0",
  "private": true,
  "description": "PI acquisition-age tax and funded BNB rewards, OpenFour review source",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "format": "prettier --plugin=prettier-plugin-solidity --write \"src/**/*.sol\" \"test/**/*.cjs\" \"protocol/*.cjs\" \"hardhat.config.cjs\" \"../website/*.js\" \"../tests/*.cjs\" \"../scripts/**/*.{js,cjs,mjs}\" \"../*.json\" \"../.github/workflows/*.yml\"",
    "format:check": "prettier --plugin=prettier-plugin-solidity --check \"src/**/*.sol\" \"test/**/*.cjs\" \"protocol/*.cjs\" \"hardhat.config.cjs\" \"../website/*.js\" \"../tests/*.cjs\" \"../scripts/**/*.{js,cjs,mjs}\" \"../*.json\" \"../.github/workflows/*.yml\"",
    "clean": "hardhat clean",
    "test:abi": "hardhat test test/compatibility.test.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.2",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.4.1",
    "solc": "0.8.24"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6"
  },
  "overrides": {
    "tmp": "0.2.7",
    "serialize-javascript": "7.1.3",
    "cookie": "0.7.2",
    "diff": "8.0.3",
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
